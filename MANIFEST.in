include LICENSE README.md Dockerfile requirements.txt
include .github/workflows/ci.yml
recursive-include src *.py
recursive-include tests *.py
recursive-include tests/regression/fixtures *.json
recursive-include examples *.py *.ipynb
recursive-include docs *.md *.tex
recursive-include docs/assets *.svg *.png *.csv *.json
recursive-include data *.gml
